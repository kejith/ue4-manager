# Copy to .env on your server (never commit actual values).
EU4_API_TOKEN=
DASHBOARD_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-at-least-32-random-bytes-hex-encoded
UE4_PORT=8080
# HTTPS reverse proxy at ue4.sane.run is required with the default secure cookie.
COOKIE_SECURE=true
# Optional override; default points to the official game API.
# EU4_API_BASE=https://www.empire-universe.com/api/v1
